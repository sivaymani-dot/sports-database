create database sports2;
use sports2;
CREATE TABLE KABBADI (
   Player_ID INT PRIMARY KEY,
   Player_Name VARCHAR(50) NOT NULL,
   Age INT,
   Achivements VARCHAR(50)
   );
   CREATE TABLE CRICKET (
   Player_ID INT PRIMARY KEY,
   Player_Name VARCHAR(50) NOT NULL,
   Age INT,
   Achivements VARCHAR(50)
);
CREATE TABLE TENNIS (
   Player_ID INT PRIMARY KEY,
   Player_Name VARCHAR(50) NOT NULL,
   Age INT,
   Achivements VARCHAR(50)
);
CREATE TABLE BATMINTON (
   Player_ID INT PRIMARY KEY,
   Player_Name VARCHAR(50) NOT NULL,
   Age INT,
   Achivements VARCHAR(50)
);
CREATE TABLE LONGJUMP (
   Player_ID INT PRIMARY KEY,
   Player_Name VARCHAR(50) NOT NULL,
   Age INT,
   Achivements VARCHAR(50)
);

